{
  "name": "nodecode",
  "version": "0.1.0",
  "private": true,
  "description": "NodeCode: VS Code extension turning a codebase into an editable node graph with agent-enforced locks",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/extension",
    "packages/webview"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w packages/core && npm run build -w packages/webview && npm run build -w packages/extension",
    "build:core": "npm run build -w packages/core",
    "build:webview": "npm run build -w packages/webview",
    "build:ext": "npm run build -w packages/extension",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint packages --ext .ts,.tsx",
    "format": "prettier --write \"packages/**/*.{ts,tsx}\"",
    "typecheck": "tsc -b packages/core && tsc --noEmit -p packages/extension && tsc --noEmit -p packages/webview"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.24.2": true
  }
}
