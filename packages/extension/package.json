{
  "name": "code_modules",
  "displayName": "code_modules",
  "description": "Node-based code view with agent-enforced locks: edit your codebase as a graph, lock modules the AI can't touch",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "publisher": "code-modules-dev",
  "type": "commonjs",
  "main": "dist/extension.js",
  "icon": "assets/icon.png",
  "sponsor": {
    "url": "https://example.com/code_modules"
  },
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=20"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "AI"
  ],
  "activationEvents": [
    "onView:code_modules.graph"
  ],
  "contributes": {
    "commands": [
      {
        "command": "code_modules.openGraph",
        "title": "code_modules: Open Graph",
        "category": "code_modules"
      },
      {
        "command": "code_modules.refresh",
        "title": "code_modules: Refresh Graph",
        "category": "code_modules"
      },
      {
        "command": "code_modules.init",
        "title": "code_modules: /init \u2014 Scan workspace and generate metadata",
        "category": "code_modules"
      },
      {
        "command": "code_modules.showLocks",
        "title": "code_modules: Show locked nodes",
        "category": "code_modules"
      }
    ],
    "configuration": {
      "title": "code_modules",
      "properties": {
        "code_modules.depth": {
          "type": "number",
          "default": 2,
          "description": "Dependency expansion depth when searching (1-4)."
        },
        "code_modules.autoLayout": {
          "type": "boolean",
          "default": true,
          "description": "Use dagre auto-layout for the graph."
        },
        "code_modules.checkCommand": {
          "type": "string",
          "default": "",
          "description": "Read-only check command run after agent edits (e.g. 'npx tsc --noEmit'). Empty disables the indirect breakage guard."
        },
        "code_modules.reviewEdits": {
          "type": "boolean",
          "default": false,
          "description": "Require diff review before agent edits apply. Default: auto-apply (edits are still logged and undoable)."
        },
        "code_modules.excludedFolders": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/dist/**",
            "**/out/**",
            "**/.nodes/**"
          ],
          "description": "Glob patterns excluded from scanning."
        },
        "code_modules.maxVisibleNodes": {
          "type": "number",
          "default": 250,
          "description": "Cap visible nodes in the webview; extra nodes collapse into layer groups."
        },
        "code_modules.modelProvider": {
          "type": "string",
          "enum": [
            "claude",
            "mock"
          ],
          "default": "claude",
          "description": "Model behind the code_modules agent. 'mock' runs fully offline with deterministic scripted answers."
        },
        "code_modules.initBudgetTokens": {
          "type": "number",
          "default": 750000,
          "description": "Hard cap (estimated tokens) for a /init scan."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "code_modules.chat",
        "name": "code_modules",
        "description": "Scan the workspace (/init) and ask about your code graph. Secret: locked nodes expose contracts only.",
        "isSticky": true,
        "commands": [
          {
            "name": "init",
            "description": "Scan the workspace bottom-up and generate node metadata + default locks"
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "npm run build"
  },
  "dependencies": {
    "@code_modules/core": "*",
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "web-tree-sitter": "^0.25.0",
    "tree-sitter-wasms": "^0.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.4.1",
    "esbuild": "^0.24.0"
  }
}
